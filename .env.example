# Choose one provider. Never commit real keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# For any other OpenAI-compatible server:
SYSTEM2_BASE_URL=http://127.0.0.1:8000/v1
SYSTEM2_API_KEY=local-development-key

# ---------------------------------------------------------------------------
# The G1 host mission service (`exp-agent-g1 serve`, pip install -e '.[g1]')
#
# These names are deliberately the SAME ones g1_auto_navigation's dashboard dev
# server reads, so one webui/.env.local configures both and nobody has to keep
# two files in step:
#     exp-agent-g1 serve --env-file ../g1_auto_navigation/webui/.env.local
# ---------------------------------------------------------------------------

# The model that plans missions. ⚠️ PINNED, never "latest": a model id that moves
# underneath a physically consequential prompt changes behaviour with no diff
# anywhere in this repo. It must support tool calling.
# MISSION_MODEL=anthropic/claude-opus-4.1
# OPENROUTER_API_KEY=
# MISSION_EFFORT=high

# Any OpenAI-compatible Chat Completions server instead of OpenRouter (vLLM,
# Ollama, or a mock). MISSION_API_KEY when yours wants a bearer token.
# MISSION_BASE_URL=
# MISSION_API_KEY=

# The robot, over the fleet broker. The service publishes ONLY /goal_pose --
# never /cmd_vel, never /estop -- and that is enforced in wire.py, not here.
# G1_MQTT_HOST=127.0.0.1
# G1_MQTT_PORT=1883
# G1_ROBOT_ID=g1-0001

# The SONIC simulator, as a SECOND target on the same broker. Every mission
# names its target (`--robot sim`, or the dashboard tab's ?robot=), so the two
# cannot be confused; the sim gets its own link, its own map and reads its pose
# off ground-truth /odom because it has no localizer. G1_SIM_ROBOT_ID=none
# removes the target.
# G1_SIM_ROBOT_ID=g1-sim-0001
# G1_SIM_MAP=procthor_val_0
# G1_SIM_POSE_TOPIC=/odom

# Bounds on one mission. wall clock, model calls, and how long a step may sit
# waiting for an operator's press before it is declined.
# MISSION_MAX_MODEL_CALLS=20
# MISSION_WALL_CLOCK_S=900
# MISSION_GATE_TIMEOUT_S=300

# Head-camera frames into the model's prompt. ON by default: the camera is how
# the model verifies a walk by looking rather than by trusting a pose. It costs
# link bandwidth (the preview topics are the heaviest thing on the robot link)
# and every look grows the conversation, which MISSION_MAX_LOOKS bounds. With
# no camera container up the model simply gets no pictures. MISSION_CAMERA=0
# turns it off for every target.
# MISSION_CAMERA=1
# MISSION_MAX_LOOKS=12

# ---------------------------------------------------------------------------
# WALKING UP TO SOMETHING THE ROBOT CAN SEE (the local_planner tool)
# ---------------------------------------------------------------------------
# navigate_to goes to a LABELLED place. local_planner walks the last few metres
# to a THING in the current camera frame -- "the sink" -- by grounding it in the
# picture, measuring it with the head camera's metric depth
# (/g1/head/depth/compressed plus the retained /g1/head/depth_info), and
# checking the way on Nav2's local costmap. It needs the camera; with
# MISSION_CAMERA=0 it is not offered at all.
# MISSION_LOCAL_PLANNER=1

# How far short of the thing to stop, in metres, MEASURED FROM THE ROBOT'S
# CENTRE. ⚠️ THAT IS NOT THE GAP YOU WILL SEE: the G1's body reaches 0.31 m
# forward, so 0.60 here is 0.29 m of clear air in front of it. Missions should
# ask the `local_planner` tool for `clearance_m` instead and let it convert; this
# is the default when they do not.
#
# The FLOOR is derived, not written down: stop zone + arrival box + margin
# = 0.40 + 0.10 + 0.10 = 0.60. Below it a goal can be satisfied INSIDE the
# circle that halts the robot, which presents as a walk that stopped for no
# reason and logs nothing.
# MISSION_LOCAL_STANDOFF_M=0.6

# Nav2's `xy_goal_tolerance`, MIRRORED HERE BECAUSE THIS PROCESS CANNOT READ
# NAV2'S YAML. The goal checker latches anywhere inside this radius, so it comes
# straight off the clearance the robot is promised -- and the standoff floor
# above is derived from it, so getting it wrong is not silent in the safe
# direction: too large only refuses close approaches.
#
# ⚠️ IT IS BACKEND-DEPENDENT. g1_auto_navigation ships 0.10 in
# nav2_g1_robot.yaml (Unitree's gait creeps at a 0.10 m/s momentum floor) and
# holds 0.25 in the nav2_g1_sonic.yaml overlay (SONIC's WALK mode commits to
# 0.8 m/s off a 0.15 deadband and would fly through a 0.10 m box). So:
#     BACKEND=unitree  ->  0.10   (floor 0.60, closest stand 0.29 m of clearance)
#     BACKEND=sonic    ->  0.25   (floor 0.75, closest stand 0.44 m of clearance)
# Worst-case body clearance is 0.19 m either way; only how close the robot may
# be ASKED to stand changes.
# MISSION_LOCAL_ARRIVAL_BOX_M=0.10

# The longest single leg. NOT a limit on how far the target may be: the costmap
# is a rolling window a few metres across while the camera sees across a room,
# so a further target simply becomes several legs, the model looking again
# between each.
# MISSION_LOCAL_MAX_LEG_M=4

# The robot's circumscribed radius, matching Nav2's robot_radius. The costmap's
# lethal cells are re-inflated by this before a path is checked.
# MISSION_LOCAL_FOOTPRINT_M=0.35

# How long a local costmap may go without a message before it is refused. Looser
# than the pose gate because Nav2 publishes a patch only when something CHANGED,
# so a robot standing in a still room is quiet and healthy.
# MISSION_LOCAL_COSTMAP_STALE_S=5

# Past this the depth camera's own ranging is not trusted.
# MISSION_LOCAL_RANGE_MAX_M=6

# The model that finds the object in the picture. Empty means the mission model.
# ⚠️ A SEPARATE CLIENT AT LOW EFFORT ON PURPOSE: the mission model reasons hard
# because it is deciding what a robot should do, and "where is the sink in this
# photo" is not that job. A cheaper vision model here is a legitimate choice.
# MISSION_GROUNDING_MODEL=
# MISSION_GROUNDING_EFFORT=low
# MISSION_GROUNDING_MIN_CONFIDENCE=0.5

# Where the service listens. Loopback on purpose -- the dashboard's dev server
# proxies /mission/* to it, and that server is the surface already exposed on
# the tailnet. Do not add a second one without deciding to.
# MISSION_BIND=127.0.0.1
# MISSION_PORT=8765
